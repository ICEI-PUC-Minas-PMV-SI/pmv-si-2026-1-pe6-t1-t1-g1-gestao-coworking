    {
      "name": "Buscar notificacao por ID",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('notificacaoIdResolved', pm.collectionVariables.get('notificacaoId') || pm.environment.get('notificacaoId') || '10');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Retorna a notificacao solicitada', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(String(body.id_notificacao)).to.eql(pm.variables.get('notificacaoIdResolved'));",
              "    pm.expect(body).to.have.property('corpo');",
              "    pm.expect(body).to.have.property('tipo');",
              "});"
            ]
          }
