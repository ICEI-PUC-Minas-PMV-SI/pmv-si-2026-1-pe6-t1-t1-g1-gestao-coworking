  "item": [
    {
      "name": "Listar tipos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Retorna lista de tipos', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('tipos');",
              "    pm.expect(body.tipos).to.be.an('array').that.is.not.empty;",
              "    pm.expect(body.tipos).to.include('Alerta');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notificacoes/tipos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notificacoes",
            "tipos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Criar notificacao",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Retorna notificacao criada', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('id_notificacao');",
              "    pm.expect(body).to.have.property('corpo', 'Reserva confirmada');",
              "    pm.expect(body).to.have.property('tipo', 'Confirmação de Reserva');",
              "    pm.expect(body).to.have.property('lida', false);",
              "    pm.expect(body).to.have.property('criado_em');",
              "    pm.collectionVariables.set('notificacaoId', String(body.id_notificacao));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
