  "item": [
    {
      "name": "Criar notificacao sem corpo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test('Erro de corpo obrigatorio', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('detail');",
              "    pm.expect(JSON.stringify(body.detail)).to.include('corpo');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"Alerta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notificacoes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notificacoes"
          ]
        }
      },
      "response": []
    },
